# ──────────────────────────────────────────────────────────────
# trestle-website/contracts/.env  (never commit real values)
# Copy this file to .env and fill in your actual secrets.
# ──────────────────────────────────────────────────────────────

# Polygon RPC endpoint (Alchemy / Infura / QuickNode / public)
POLYGON_RPC_URL=https://polygon-rpc.com

# Deployer wallet private key (0x-prefixed)
DEPLOYER_PRIVATE_KEY=

# Polygonscan API key (https://polygonscan.com/apis) for contract verification
POLYGONSCAN_API_KEY=

# Etherscan v2 API key (https://etherscan.io/apis) — single key covers Ethereum + Polygon + all supported chains
ETHERSCAN_API_KEY=

# ── Mainnet token addresses (pre-filled from STATUS.md) ─────
HNOBT_ADDRESS=0xcF51ab7398315DbA6588Aa7fb3Df7c99D3D1F4dD
# BRT has a 5% transfer fee on every tx
BRT_ADDRESS=0xeCb4cAc0C9e5cBd42a9Ed36467ce8f96072AD58b
# BRT/WPOL LP pair (used as staking token for BroilerPlusStaking Tier 2)
BRT_LP_ADDRESS=0xc445b18b3ff85e0691fe416ad91e456f8697b166
