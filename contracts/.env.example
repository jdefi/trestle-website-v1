# Required
DEPLOYER_PRIVATE_KEY=0x...

# For Polygon mainnet
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Etherscan API key (optional — skips verification if not set)
ETHERSCAN_API_KEY=...

# Token addresses (optional — defaults to mainnet known addresses)
HNBT_ADDRESS=0x...
BRT_ADDRESS=0x...
BRT_LP_ADDRESS=0x...

# Gas price is fetched dynamically from provider (fee data +10%).
# No manual gas price env var needed.
