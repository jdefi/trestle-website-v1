# ============================================
# trestle.website - Frontend Environment Variables
# ============================================

# WalletConnect (Required)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Biconomy (for gasless transactions)
NEXT_PUBLIC_BICONOMY_API_KEY=your_biconomy_api_key

# API (Required)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Contract Addresses (Optional - for future features)
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=0x...

# Blockscout RPC (Optional - add your Blockscout RPC endpoints)
NEXT_PUBLIC_BLOCKSCOUT_API=https://polygon-blockscout.example.com  # Polygon mainnet
NEXT_PUBLIC_BLOCKSCOUT_API_AMOY=https://amoy-blockscout.example.com  # Amoy testnet