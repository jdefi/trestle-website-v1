# ============================================
# trestle.website - Frontend Environment Variables
# ============================================

# WalletConnect (Required)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# API (Required)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Relayer Mode (Required for gasless claims)
NEXT_PUBLIC_RELAYER_MODE=self-hosted    # "self-hosted" or "biconomy"

# Contract Addresses (Required)
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=0x...   # RewardDistributor contract address

# Biconomy (Required if relayer mode is "biconomy")
NEXT_PUBLIC_BICONOMY_API_KEY=your_biconomy_api_key_here

# Blockscout RPC (Optional - add your Blockscout RPC endpoints)
# Used as part of round-robin load balancing with other providers
NEXT_PUBLIC_BLOCKSCOUT_API=https://polygon-blockscout.example.com  # Polygon mainnet
NEXT_PUBLIC_BLOCKSCOUT_API_AMOY=https://amoy-blockscout.example.com  # Amoy testnet